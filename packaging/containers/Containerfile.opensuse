# =============================================================================
# Packathon - openSUSE Tumbleweed Containers (Vanilla Demo & Builder)
# =============================================================================
# Targets:
#   - vanilla-demo: Pristine openSUSE runtime environment + demo ergonomics (fzf, prompt, history).
#                   Contains NO compilers and NO ocio runtime dependencies.
#   - builder:      Full build-time environment (inherits vanilla-demo and adds dev tools).
#
# Usage:
#   1. Build the vanilla demo image:
#      podman build --target vanilla-demo -t localhost/packathon-opensuse:demo -f packaging/containers/Containerfile.opensuse packaging/containers
#      podman run --rm -it -e DISPLAY -v /tmp/.X11-unix:/tmp/.X11-unix:ro --device /dev/dri -v "$PWD:/src:Z" localhost/packathon-opensuse:demo
#
#   2. Build the builder image (default):
#      podman build -t localhost/packathon-opensuse:builder -f packaging/containers/Containerfile.opensuse packaging/containers
#
#   3. Build packages with CPack (default: RAYLIB_MODE=FETCH, static raylib):
#      podman run --rm -v "$PWD:/src:Z" localhost/packathon-opensuse:builder packaging/containers/build-package.sh
#      # Generated .rpm and .tar.gz packages are placed in ./dist/
#
#      # Build with shared raylib (libraylib.so):
#      podman run --rm -v "$PWD:/src:Z" -e RAYLIB_SHARED=ON localhost/packathon-opensuse:builder packaging/containers/build-package.sh
#      # Build using the distro raylib-devel (fails unless its version matches RAYLIB_VERSION):
#      podman run --rm -v "$PWD:/src:Z" -e RAYLIB_MODE=SYSTEM localhost/packathon-opensuse:builder packaging/containers/build-package.sh
#      # Build using pre-staged local source (offline/hermetic, no network):
#      podman run --rm -v "$PWD:/src:Z" -e RAYLIB_MODE=LOCAL localhost/packathon-opensuse:builder packaging/containers/build-package.sh
#
#   4. Other recipes (hand-written spec, AppImage):
#      podman run --rm -v "$PWD:/src:Z" localhost/packathon-opensuse:builder packaging/rpm/build-rpm.sh
#      podman run --rm -v "$PWD:/src:Z" -e BUILD_DIR=/tmp/build -e OUTPUT_DIR=/src/dist \
#        localhost/packathon-opensuse:builder packaging/appimage/build-appimage.sh
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Vanilla Demo Environment (clean runtime + presentation ergonomics)
# -----------------------------------------------------------------------------
FROM registry.opensuse.org/opensuse/tumbleweed:latest AS vanilla-demo

LABEL org.opencontainers.image.title="Packathon openSUSE Vanilla Demo" \
      org.opencontainers.image.description="Pristine openSUSE Tumbleweed runtime environment with demo ergonomics (fzf, prompt, history)"

# Install fzf (only pulls glibc, no graphics/sound libraries)
# Temporary workaround: download.opensuse.org (MirrorBrain) can redirect CI runners to regional
# mirrors that are in the middle of synchronization, causing package digest verification failures
# (e.g. exit code 8 on noarch packages like file-magic). Rewriting repo URLs to https://cdn.opensuse.org
# routes requests through Fastly CDN (which requires HTTPS) and serves consistent, synchronized packages.
RUN sed -i -e 's|http://download.opensuse.org|https://cdn.opensuse.org|g' \
           -e 's|https://download.opensuse.org|https://cdn.opensuse.org|g' /etc/zypp/repos.d/*.repo && \
    zypper --non-interactive refresh && \
    zypper --non-interactive in --no-recommends fzf && \
    zypper clean -a && \
    rm -rf /var/cache/zypp/*

# Cyan prompt to distinguish Vanilla from Green Builder
RUN echo "export PS1='\[\e[36m\][OPENSUSE VANILLA]\w\[\e[0m\]# '" >> /root/.bashrc && \
    echo '[ -f /usr/share/fzf/shell/key-bindings.bash ] && source /usr/share/fzf/shell/key-bindings.bash' >> /root/.bashrc

COPY cmd_history.opensuse /root/.bash_history

WORKDIR /src
CMD ["/bin/bash"]

# -----------------------------------------------------------------------------
# Stage 2: Builder (build-time tools only)
# -----------------------------------------------------------------------------
FROM vanilla-demo AS builder

LABEL org.opencontainers.image.title="Packathon openSUSE Builder" \
      org.opencontainers.image.description="Build-time environment for compiling ocio and packaging RPMs"

# Green prompt to distinguish Builder from Vanilla
RUN echo "export PS1='\[\e[32m\][OPENSUSE BUILDER]\w\[\e[0m\]# '" >> /root/.bashrc

RUN zypper --non-interactive in --no-recommends \
        # [Build-Time Tools]
        gcc \
        gcc-c++ \
        make \
        cmake \
        git \
        ca-certificates-mozilla \
        curl \
        file \
        tar \
        gzip \
        # [Build-Time Development Headers]
        libX11-devel \
        libXrandr-devel \
        libXinerama-devel \
        libXcursor-devel \
        libXi-devel \
        Mesa-libGL-devel \
        alsa-devel \
        # [Distro raylib for RAYLIB_MODE=SYSTEM]
        # The only ocio dependency in the image: FETCH/LOCAL builds ignore it.
        # Tumbleweed is rolling, so its version depends on when the image was
        # built; CMake stops SYSTEM builds unless it matches RAYLIB_VERSION.
        raylib-devel \
        # [Packaging Tools]
        rpm-build \
        flatpak \
        flatpak-builder \
        AppStream \
        # elfutils provides eu-strip and eu-elfcompress, required by flatpak-builder
        # to strip debug symbols from built binaries during packaging
        elfutils \
    && zypper clean -a \
    && rm -rf /var/cache/zypp/*

# Install appimagetool (pre-extracted to run inside container without FUSE)
# Dynamically detect architecture (x86_64 vs aarch64) to support multi-platform builder images
RUN ARCH=$(uname -m) && \
    curl -sLo /tmp/appimagetool "https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-${ARCH}.AppImage" && \
    chmod +x /tmp/appimagetool && \
    cd /tmp && ./appimagetool --appimage-extract && \
    mv squashfs-root /usr/lib/appimagetool && \
    ln -s /usr/lib/appimagetool/AppRun /usr/local/bin/appimagetool && \
    rm -f /tmp/appimagetool

# appimagetool otherwise downloads the type2 runtime itself at every build,
# and can hang there: fetch it once and pass it explicitly.
RUN ARCH=$(uname -m) && \
    curl -sLo "/tmp/runtime-${ARCH}" "https://github.com/AppImage/type2-runtime/releases/download/continuous/runtime-${ARCH}" && \
    mv "/tmp/runtime-${ARCH}" "/usr/lib/runtime-${ARCH}"

# Pre-install Flatpak runtime and SDK for building org.packathon.ocio.
# The remote is deleted afterwards so no network remote remains configured.
RUN flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo && \
    flatpak install -y --noninteractive flathub \
        org.freedesktop.Platform//25.08 \
        org.freedesktop.Sdk//25.08 && \
    flatpak remote-delete --force flathub && \
    ARCH=$(uname -m) && \
    ln -sf /usr/libexec/appstreamcli-compose \
        "/var/lib/flatpak/runtime/org.freedesktop.Sdk/${ARCH}/25.08/active/files/bin/appstream-compose"

WORKDIR /src

# No project source and no ocio build in the image: mount the checkout at /src
# and name the script to run. With no command, the image opens a shell.
CMD ["/bin/bash"]
