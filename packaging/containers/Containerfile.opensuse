# =============================================================================
# Packathon - Multi-Stage openSUSE Tumbleweed Build & Runtime Container
# =============================================================================
# Separation of concerns:
#   Stage 1 (builder): Strict build-time tools, dev headers, and rpm-build.
#   Stage 2 (runtime): Vanilla minimal base + strictly runtime libraries only.
#
# Usage:
#   1. Build packages (default: FetchContent=ON, static raylib):
#      podman build --target builder -t localhost/packathon-opensuse:builder -f packaging/containers/Containerfile.opensuse .
#      podman run --rm -v "$PWD:/src:Z" -w /src localhost/packathon-opensuse:builder
#      # Generated .rpm and .tar.gz packages are placed in ./dist/
#
#   2. Build with custom options (RAYLIB_MODE, RAYLIB_SHARED):
#      # Build with shared raylib (libraylib.so):
#      podman run --rm -v "$PWD:/src:Z" -e RAYLIB_SHARED=ON localhost/packathon-opensuse:builder
#      # Build using system raylib package (fails if raylib-devel not installed):
#      podman run --rm -v "$PWD:/src:Z" -e RAYLIB_MODE=SYSTEM localhost/packathon-opensuse:builder
#      # Build using pre-staged local source (offline/hermetic, no network):
#      podman run --rm -v "$PWD:/src:Z" -e RAYLIB_MODE=LOCAL localhost/packathon-opensuse:builder
#
#   3. Build lightweight runtime GUI container:
#      podman build --target runtime -t localhost/packathon-opensuse:runtime -f packaging/containers/Containerfile.opensuse .
#
#   4. Run the GUI application using Podman on the host display:
#      xhost +local:$USER
#      podman run --rm --net=host --ipc=host \
#        -e DISPLAY=$DISPLAY \
#        -v /tmp/.X11-unix:/tmp/.X11-unix:ro \
#        --device /dev/dri \
#        localhost/packathon-opensuse:runtime
# =============================================================================

# -----------------------------------------------------------------------------
# STAGE 1: Builder (Build-time dependencies only)
# -----------------------------------------------------------------------------
FROM registry.opensuse.org/opensuse/tumbleweed:latest AS builder

LABEL org.opencontainers.image.title="Packathon openSUSE Builder" \
      org.opencontainers.image.description="Build-time environment for compiling ocio and packaging RPMs"

# Install build tools and development headers
RUN zypper --non-interactive refresh && \
    zypper --non-interactive in --no-recommends \
        # [Build-Time Tools]
        gcc \
        gcc-c++ \
        make \
        cmake \
        git \
        ca-certificates-mozilla \
        curl \
        file \
        tar \
        gzip \
        # [Build-Time Development Headers]
        libX11-devel \
        libXrandr-devel \
        libXinerama-devel \
        libXcursor-devel \
        libXi-devel \
        Mesa-libGL-devel \
        alsa-devel \
        # [Packaging Tools]
        rpm-build \
        flatpak \
        flatpak-builder \
    && zypper clean -a \
    && rm -rf /var/cache/zypp/*

# Install appimagetool (pre-extracted to run inside container without FUSE)
RUN curl -sLo /tmp/appimagetool https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage && \
    chmod +x /tmp/appimagetool && \
    cd /tmp && ./appimagetool --appimage-extract && \
    mv squashfs-root /usr/lib/appimagetool && \
    ln -s /usr/lib/appimagetool/AppRun /usr/local/bin/appimagetool && \
    rm -f /tmp/appimagetool

WORKDIR /src

# Copy project source into container for self-contained multi-stage build of runtime stage
COPY . /src-build

# Build binary in /build so Stage 2 can copy it directly
RUN cmake -S /src-build -B /build -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /build --config Release -j$(nproc)

# Install shared packaging script
COPY packaging/containers/build-package.sh /usr/local/bin/build-package.sh
RUN chmod +x /usr/local/bin/build-package.sh

# Default action when run with volume mount (-v "$PWD:/src:Z"):
# Runs /usr/local/bin/build-package.sh, which compiles in an isolated /tmp/build scratchpad
# and exports generated packages to /src/dist/ (configurable via RAYLIB_MODE and RAYLIB_SHARED).
CMD ["/usr/local/bin/build-package.sh"]


# -----------------------------------------------------------------------------
# STAGE 1b: Builder with System Raylib (Inherits builder + adds raylib-devel)
# -----------------------------------------------------------------------------
FROM builder AS builder-system

LABEL org.opencontainers.image.title="Packathon openSUSE Builder (System Raylib)" \
      org.opencontainers.image.description="Build-time environment with pre-installed raylib-devel for RAYLIB_MODE=SYSTEM"

# Install raylib-devel strictly in this specialized stage only
RUN zypper --non-interactive in --no-recommends raylib-devel && \
    zypper clean -a && \
    rm -rf /var/cache/zypp/*

ENV RAYLIB_MODE=SYSTEM

CMD ["/usr/local/bin/build-package.sh"]


# -----------------------------------------------------------------------------
# STAGE 2: Runtime (Runtime dependencies only on vanilla minimal openSUSE)
# -----------------------------------------------------------------------------
FROM registry.opensuse.org/opensuse/tumbleweed:latest AS runtime

LABEL org.opencontainers.image.title="Packathon openSUSE Runtime" \
      org.opencontainers.image.description="Minimal vanilla openSUSE runtime environment for ocio GUI"

# Install strictly RUNTIME shared libraries required to execute ocio
# (No gcc, no cmake, no git, no devel packages)
RUN zypper --non-interactive refresh && \
    zypper --non-interactive in --no-recommends \
        # [Runtime Graphics & Display Libraries]
        libX11-6 \
        Mesa-libGL1 \
        libGLU1 \
        # [Runtime Audio Library]
        libasound2 \
    && zypper clean -a \
    && rm -rf /var/cache/zypp/*

# Copy compiled binary from builder stage
COPY --from=builder /build/bin/ocio /usr/local/bin/ocio

# Non-root user setup for running GUI application safely
RUN useradd -m -u 1000 appuser
USER appuser
ENV HOME=/home/appuser

ENTRYPOINT ["/usr/local/bin/ocio"]
