# === Build Recipes ===
packaging/build_ocio.sh
packaging/deb/build-deb.sh
packaging/appimage/build-appimage.sh
packaging/flatpak/build-flatpak.sh

cmake -S . -B build-debian -DCMAKE_BUILD_TYPE=Release && cmake --build build-debian -j$(nproc)

export BU=build_debian_RAYLIB_MODE_FETCH
cmake -S . -B $BU -DCMAKE_BUILD_TYPE=Release -DRAYLIB_MODE=FETCH && cmake --build $BU -j$(nproc)

export BU=build_debian_RAYLIB_MODE_LOCAL
tar -xf raylib_vendoring/raylib-5.5.tar.gz -C raylib_vendoring
cmake -S . -B $BU -DCMAKE_BUILD_TYPE=Release -DRAYLIB_MODE=LOCAL -DRAYLIB_LOCAL=/src/raylib_vendoring/raylib-5.5 && cmake --build $BU -j$(nproc)

export BU=build_debian_RAYLIB_MODE_SYSTEM
apt-cache search raylib
apt-cache search libraylib-dev
apt-cache search libraylib
apt search libraylib
apt search raylib
apt-get install libraylib-dev
echo "deb http://deb.debian.org/debian unstable main" | tee /etc/apt/sources.list.d/unstable.list
apt install -t unstable libraylib-dev
dpkg -L libraylib-dev

ls /var/lib/dpkg/info/*.shlibs
cat /var/lib/dpkg/info/libc6:amd64.shlibs

cmake -S . -B $BU -DCMAKE_BUILD_TYPE=Release -DRAYLIB_MODE=SYSTEM && cmake --build $BU -j$(nproc)

cmake -S . -B build-debian-shared -DCMAKE_BUILD_TYPE=Release -DRAYLIB_SHARED=ON && cmake --build build-debian-shared -j$(nproc)
cmake -S . -B build-debian-static -DCMAKE_BUILD_TYPE=Release -DRAYLIB_SHARED=OFF && cmake --build build-debian-static -j$(nproc)
rm -rf build-*

# === Foundations: Binary & Linker Inspection ===
./dist/ocio --version
readelf -p .interp dist/cmake/ocio
readelf -d dist/cmake/ocio | grep NEEDED
readelf -h dist/cmake/ocio | grep -E 'Type:|Entry point'
readelf -l dist/cmake/ocio | grep -A1 INTERP
readelf -s dist/cmake/ocio | grep -E ' (main|_start)$'
ldd dist/cmake/ocio
strings dist/cmake/ocio | grep -E "^GLIBC_2\." | sort -V | tail -n 5

# === Vanilla Walkthrough: Step-by-Step Dependency Resolution ===
apt-get update
apt-get install -y --no-install-recommends libx11-6
apt-get install -y --no-install-recommends libglx0
apt-get install -y file xxd squashfs-tools binutils fuse3

# === Route 1: DEB Dissection & Verification ===
file dist/ocio_0.1.0_amd64.deb
ar -t dist/ocio_0.1.0_amd64.deb
dpkg-deb -I dist/ocio_0.1.0_amd64.deb
dpkg-deb -I dist/ocio_0.1.0_amd64.deb | grep -E "Package:|Version:|Depends:|Recommends:"
dpkg-deb -c dist/ocio_0.1.0_amd64.deb
dpkg-shlibdeps -O dist/ocio
dpkg -i dist/ocio_0.1.0_amd64.deb
apt-get update && apt-get install -y ./dist/ocio_0.1.0_amd64.deb
dpkg --verify ocio

# === Route 2: AppImage Mechanics ===
# Shared-raylib A/B test: linuxdeploy (scans DT_NEEDED, bundles libraylib.so)
BUILD_DIR=/src/build-try-shared OUTPUT_DIR=/src/dist-try RAYLIB_SHARED=ON packaging/appimage/build-appimage.sh --method linuxdeploy
find /src/build-try-shared/AppDir/usr/lib -name "libraylib*"
readelf -d /src/build-try-shared/AppDir/usr/bin/ocio | grep -E "RUNPATH|NEEDED"
file dist/ocio-x86_64.AppImage
dist/ocio-x86_64.AppImage --version
xxd -l 96 -d dist/ocio-x86_64.AppImage
hexdump -C -n 96 dist/ocio-x86_64.AppImage
readelf -d dist/ocio-x86_64.AppImage
dist/ocio-x86_64.AppImage --appimage-offset
ls -lh dist/ocio-x86_64.AppImage
unsquashfs -s -offset $(dist/ocio-x86_64.AppImage --appimage-offset) dist/ocio-x86_64.AppImage
unsquashfs -l -offset $(dist/ocio-x86_64.AppImage --appimage-offset) dist/ocio-x86_64.AppImage
dist/ocio-x86_64.AppImage --appimage-mount &
df -h | grep /tmp/.mount
df -h /tmp/.mount_*
ls -la /tmp/.mount_*/
readelf -d /tmp/.mount_*/usr/bin/ocio | grep NEEDED
strings /tmp/.mount_*/usr/bin/ocio | grep -E '^GLIBC_2\.' | sort -V | tail -n 5
dist/ocio-x86_64.AppImage --appimage-extract
ls -la squashfs-root
./squashfs-root/AppRun
./dist/ocio-x86_64.AppImage --appimage-extract && ./squashfs-root/AppRun
objdump -T squashfs-root/usr/local/bin/ocio | grep -E "GLIBC_2\." | sort -V | tail -n 5

# === Route 3: Flatpak & Sandbox Dissection ===
flatpak info --bundle dist/ocio.flatpak
flatpak install --user -y --noninteractive dist/ocio.flatpak
flatpak remote-add --user --if-not-exists packathon https://michelepagot.github.io/packathon/org.packathon.ocio.flatpakrepo
flatpak install --user -y packathon org.packathon.ocio
flatpak install --user -y https://michelepagot.github.io/packathon/org.packathon.ocio.flatpakref
flatpak run --command=sh org.packathon.ocio
flatpak run --command=ldd org.packathon.ocio /app/bin/ocio
flatpak run --nodevice=dri --nosocket=x11 org.packathon.ocio
