# =============================================================================
# Packathon - Multi-Stage Debian Build & Runtime Container
# =============================================================================
# Separation of concerns:
#   Stage 1 (builder): Strict build-time tools, dev headers, and dpkg-dev.
#   Stage 2 (runtime): Vanilla minimal base + strictly runtime libraries only.
#
# Usage:
#   1. Build packages (default: FetchContent=ON, static raylib):
#      podman build --target builder -t localhost/packathon-debian:builder -f packaging/containers/Containerfile.debian .
#      podman run --rm -v "$PWD:/src:Z" -w /src localhost/packathon-debian:builder
#      # Generated .deb and .tar.gz packages are placed in ./dist/
#
#   2. Build with custom options (RAYLIB_MODE, RAYLIB_SHARED):
#      # Build with shared raylib (libraylib.so):
#      podman run --rm -v "$PWD:/src:Z" -e RAYLIB_SHARED=ON localhost/packathon-debian:builder
#      # Build using system raylib package (fails if libraylib-dev not installed):
#      podman run --rm -v "$PWD:/src:Z" -e RAYLIB_MODE=SYSTEM localhost/packathon-debian:builder
#      # Build using pre-staged local source (offline/hermetic, no network):
#      podman run --rm -v "$PWD:/src:Z" -e RAYLIB_MODE=LOCAL localhost/packathon-debian:builder
#
#   3. Build lightweight runtime GUI container:
#      podman build --target runtime -t localhost/packathon-debian:runtime -f packaging/containers/Containerfile.debian .
#
#   4. Run the GUI application using Podman on the host display:
#      xhost +local:$USER
#      podman run --rm --net=host --ipc=host \
#        -e DISPLAY=$DISPLAY \
#        -v /tmp/.X11-unix:/tmp/.X11-unix:ro \
#        --device /dev/dri \
#        localhost/packathon-debian:runtime
# =============================================================================

# -----------------------------------------------------------------------------
# STAGE 1: Builder (Build-time dependencies only)
# -----------------------------------------------------------------------------
FROM debian:bookworm-slim AS builder

LABEL org.opencontainers.image.title="Packathon Debian Builder" \
      org.opencontainers.image.description="Build-time environment for compiling ocio and packaging DEBs"

ENV DEBIAN_FRONTEND=noninteractive

# Install build tools, dev headers, and package generator
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        # [Build-Time Tools]
        gcc \
        g++ \
        make \
        libc6-dev \
        cmake \
        git \
        ca-certificates \
        curl \
        file \
        tar \
        gzip \
        # [Build-Time Development Headers]
        libx11-dev \
        libxrandr-dev \
        libxinerama-dev \
        libxcursor-dev \
        libxi-dev \
        libgl1-mesa-dev \
        libglu1-mesa-dev \
        libasound2-dev \
        # [Packaging Tools]
        dpkg-dev \
        flatpak \
        flatpak-builder \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install appimagetool (pre-extracted to run inside container without FUSE)
RUN curl -sLo /tmp/appimagetool https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage && \
    chmod +x /tmp/appimagetool && \
    cd /tmp && ./appimagetool --appimage-extract && \
    mv squashfs-root /usr/lib/appimagetool && \
    ln -s /usr/lib/appimagetool/AppRun /usr/local/bin/appimagetool && \
    rm -f /tmp/appimagetool

WORKDIR /src

# Copy project source into container for self-contained multi-stage build of runtime stage
COPY . /src-build

# Build binary in /build so Stage 2 can copy it directly
RUN cmake -S /src-build -B /build -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /build --config Release -j$(nproc)

# Install shared packaging script
COPY packaging/containers/build-package.sh /usr/local/bin/build-package.sh
RUN chmod +x /usr/local/bin/build-package.sh

# Default action when run with volume mount (-v "$PWD:/src:Z"):
# Runs /usr/local/bin/build-package.sh, which compiles in an isolated /tmp/build scratchpad
# and exports generated packages to /src/dist/ (configurable via RAYLIB_MODE and RAYLIB_SHARED).
CMD ["/usr/local/bin/build-package.sh"]


# -----------------------------------------------------------------------------
# STAGE 1b: Builder with System Raylib (Inherits builder + installs raylib to /usr/local)
# -----------------------------------------------------------------------------
FROM builder AS builder-system

LABEL org.opencontainers.image.title="Packathon Debian Builder (System Raylib)" \
      org.opencontainers.image.description="Build-time environment with pre-installed raylib in /usr/local for RAYLIB_MODE=SYSTEM"

# Build and install raylib system-wide strictly in this specialized stage only
RUN git clone --depth 1 --branch 5.5 https://github.com/raysan5/raylib.git /tmp/raylib-build && \
    cmake -S /tmp/raylib-build -B /tmp/raylib-build/build -DBUILD_EXAMPLES=OFF -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /tmp/raylib-build/build -j$(nproc) && \
    cmake --install /tmp/raylib-build/build && \
    rm -rf /tmp/raylib-build && \
    ldconfig

ENV RAYLIB_MODE=SYSTEM

CMD ["/usr/local/bin/build-package.sh"]


# -----------------------------------------------------------------------------
# STAGE 2: Runtime (Runtime dependencies only on vanilla minimal Debian)
# -----------------------------------------------------------------------------
FROM debian:bookworm-slim AS runtime

LABEL org.opencontainers.image.title="Packathon Debian Runtime" \
      org.opencontainers.image.description="Minimal vanilla Debian runtime environment for ocio GUI"

ENV DEBIAN_FRONTEND=noninteractive

# Install strictly RUNTIME shared libraries required to execute ocio
# (No gcc, no make, no cmake, no git, no dev packages)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        # [Runtime Graphics & Display Libraries]
        libx11-6 \
        libgl1 \
        libglu1-mesa \
        libglx-mesa0 \
        # [Runtime Audio Library]
        libasound2 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy compiled binary from builder stage
COPY --from=builder /build/bin/ocio /usr/local/bin/ocio

# Non-root user setup for running GUI application safely
RUN useradd -m -u 1000 appuser
USER appuser
ENV HOME=/home/appuser

ENTRYPOINT ["/usr/local/bin/ocio"]
