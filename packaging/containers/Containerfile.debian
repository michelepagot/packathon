# =============================================================================
# Packathon - Debian Containers (Vanilla Demo & Builder)
# =============================================================================
# Targets:
#   - vanilla-demo: Pristine Debian runtime environment + demo ergonomics (fzf, prompt, history).
#                   Contains NO compilers and NO ocio runtime dependencies.
#   - builder:      Full build-time environment (inherits vanilla-demo and adds dev tools).
#
# Usage:
#   1. Build the vanilla demo image:
#      podman build --target vanilla-demo -t localhost/packathon-debian:demo -f packaging/containers/Containerfile.debian packaging/containers
#      podman run --rm -it -e DISPLAY -v /tmp/.X11-unix:/tmp/.X11-unix:ro --device /dev/dri -v "$PWD:/src:Z" localhost/packathon-debian:demo
#
#   2. Build the builder image (default):
#      podman build -t localhost/packathon-debian:builder -f packaging/containers/Containerfile.debian packaging/containers
#
#   3. Build packages with CPack (default: RAYLIB_MODE=FETCH, static raylib):
#      podman run --rm -v "$PWD:/src:Z" localhost/packathon-debian:builder packaging/containers/build-package.sh
#      # Generated .deb and .tar.gz packages are placed in ./dist/
#
#      # Build with shared raylib (libraylib.so):
#      podman run --rm -v "$PWD:/src:Z" -e RAYLIB_SHARED=ON localhost/packathon-debian:builder packaging/containers/build-package.sh
#      # No RAYLIB_MODE=SYSTEM here: Debian does not package raylib (bookworm, trixie).
#      # Build using pre-staged local source (offline/hermetic, no network):
#      podman run --rm -v "$PWD:/src:Z" -e RAYLIB_MODE=LOCAL localhost/packathon-debian:builder packaging/containers/build-package.sh
#
#   4. Other recipes (hand-written DEB, AppImage):
#      podman run --rm -v "$PWD:/src:Z" localhost/packathon-debian:builder packaging/deb/build-deb.sh
#      podman run --rm -v "$PWD:/src:Z" -e BUILD_DIR=/tmp/build -e OUTPUT_DIR=/src/dist \
#        localhost/packathon-debian:builder packaging/appimage/build-appimage.sh
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Vanilla Demo Environment (clean runtime + presentation ergonomics)
# -----------------------------------------------------------------------------
FROM debian:bookworm-slim AS vanilla-demo

LABEL org.opencontainers.image.title="Packathon Debian Vanilla Demo" \
      org.opencontainers.image.description="Pristine Debian Bookworm runtime environment with demo ergonomics (fzf, prompt, history)"

ENV DEBIAN_FRONTEND=noninteractive

# Install fzf (only pulls libc6, no graphics/sound libraries)
# (remove dpkg exclusions to allow fzf shell key-bindings from /usr/share/doc to be installed)
RUN rm -f /etc/dpkg/dpkg.cfg.d/excludes /etc/dpkg/dpkg.cfg.d/docker && \
    apt-get update && \
    apt-get install -y --no-install-recommends fzf && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Blue prompt to distinguish Vanilla from Red Builder
RUN echo "export PS1='\[\e[34m\][DEBIAN VANILLA]\w\[\e[0m\]# '" >> /root/.bashrc && \
    echo '[ -f /usr/share/doc/fzf/examples/key-bindings.bash ] && source /usr/share/doc/fzf/examples/key-bindings.bash' >> /root/.bashrc

COPY cmd_history.debian /root/.bash_history

WORKDIR /src
CMD ["/bin/bash"]

# -----------------------------------------------------------------------------
# Stage 2: Builder (build-time tools only)
# -----------------------------------------------------------------------------
FROM vanilla-demo AS builder

LABEL org.opencontainers.image.title="Packathon Debian Builder" \
      org.opencontainers.image.description="Build-time environment for compiling ocio and packaging DEBs"

# Red prompt to distinguish Builder from Vanilla
RUN echo "export PS1='\[\e[34m\][DEBIAN BUILDER]\w\[\e[0m\]# '" >> /root/.bashrc

# Enable Bookworm Backports to get a modern version of flatpak-builder
RUN echo "deb http://deb.debian.org/debian bookworm-backports main" > /etc/apt/sources.list.d/backports.list

# Install build tools, dev headers, package generator, and demo tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        # [Build-Time Tools]
        gcc \
        g++ \
        make \
        libc6-dev \
        cmake \
        git \
        ca-certificates \
        curl \
        file \
        tar \
        gzip \
        # [Build-Time Development Headers]
        libx11-dev \
        libxrandr-dev \
        libxinerama-dev \
        libxcursor-dev \
        libxi-dev \
        libgl1-mesa-dev \
        libglu1-mesa-dev \
        libasound2-dev \
        # [Packaging Tools]
        dpkg-dev \
        flatpak \
        flatpak-builder \
        appstream \
        # elfutils provides eu-strip and eu-elfcompress, required by flatpak-builder
        # to strip debug symbols from built binaries during packaging
        elfutils \
    # Install flatpak-builder specifically from backports
    && apt-get install -y --no-install-recommends -t bookworm-backports flatpak-builder \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install appimagetool (pre-extracted to run inside container without FUSE)
# Dynamically detect architecture (x86_64 vs aarch64) to support multi-platform builder images
RUN ARCH=$(uname -m) && \
    curl -sLo /tmp/appimagetool "https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-${ARCH}.AppImage" && \
    chmod +x /tmp/appimagetool && \
    cd /tmp && ./appimagetool --appimage-extract && \
    mv squashfs-root /usr/lib/appimagetool && \
    ln -s /usr/lib/appimagetool/AppRun /usr/local/bin/appimagetool && \
    rm -f /tmp/appimagetool

# Install linuxdeploy (pre-extracted like appimagetool: no FUSE needed).
# build-appimage.sh --method linuxdeploy uses it to bundle the libraries
# that are not on the AppImage excludelist.
RUN ARCH=$(uname -m) && \
    curl -sLo /tmp/linuxdeploy "https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-${ARCH}.AppImage" && \
    chmod +x /tmp/linuxdeploy && \
    cd /tmp && ./linuxdeploy --appimage-extract && \
    mv squashfs-root /usr/lib/linuxdeploy && \
    ln -s /usr/lib/linuxdeploy/AppRun /usr/local/bin/linuxdeploy && \
    rm -f /tmp/linuxdeploy

# appimagetool otherwise downloads the type2 runtime itself at every build,
# and can hang there: fetch it once and pass it explicitly.
RUN ARCH=$(uname -m) && \
    curl -sLo "/tmp/runtime-${ARCH}" "https://github.com/AppImage/type2-runtime/releases/download/continuous/runtime-${ARCH}" && \
    mv "/tmp/runtime-${ARCH}" "/usr/lib/runtime-${ARCH}"

# Pre-install Flatpak runtime and SDK for building org.packathon.ocio.
# The remote is deleted afterwards so no network remote remains configured.
RUN flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo && \
    flatpak install -y --noninteractive flathub \
        org.freedesktop.Platform//25.08 \
        org.freedesktop.Sdk//25.08 && \
    flatpak remote-delete --force flathub

WORKDIR /src

# No project source and no ocio build in the image: mount the checkout at /src
# and name the script to run. With no command, the image opens a shell.
CMD ["/bin/bash"]
